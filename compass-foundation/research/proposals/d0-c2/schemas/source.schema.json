{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "policy_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "snapshot_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "source_contract_version": {
      "const": "0.1.0"
    },
    "source_schema_version": {
      "const": "1"
    },
    "workspace_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "required": [
    "source_schema_version",
    "source_contract_version",
    "workspace_id",
    "snapshot_id",
    "policy_id",
    "snapshot_file_sha256"
  ],
  "type": "object"
}
